<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>THOSE THAT WAIT - [CHICAGO]</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');

    body {
      background-color: #020302;
      color: #e0e0e0;
      font-family: 'VT323', monospace;
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      user-select: none;
    }

    /* CRT Monitor Box */
    .crt-container {
      width: 92vw;
      max-width: 850px;
      height: 88vh;
      background: radial-gradient(circle at center, #111812 0%, #050805 100%);
      border: 14px solid #161a16;
      border-radius: 8px;
      position: relative;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 100px rgba(0,0,0,0.85);
      padding: 30px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Scanlines Overlay */
    .crt-container::before {
      content: " ";
      display: block;
      position: absolute;
      top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%), 
                  linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
      z-index: 20;
      background-size: 100% 4px, 6px 100%;
      pointer-events: none;
    }

    /* CRT Screen Flicker */
    .crt-container::after {
      content: " ";
      display: block;
      position: absolute;
      top: 0; left: 0; bottom: 0; right: 0;
      background: rgba(18, 16, 16, 0.12);
      opacity: 0;
      z-index: 20;
      pointer-events: none;
      animation: screen-flicker 0.18s infinite;
    }

    @keyframes screen-flicker {
      0% { opacity: 0.08; }
      50% { opacity: 0.02; }
      100% { opacity: 0.11; }
    }

    /* Top HUD */
    .hud-top {
      display: flex;
      justify-content: space-between;
      font-size: 1.3rem;
      color: #788a79;
      letter-spacing: 2px;
      z-index: 5;
    }

    .rec-indicator {
      color: #ff3333;
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }

    /* Title Block (Fears to Fathom Style) */
    .title-block {
      text-align: center;
      margin-top: 10px;
      z-index: 5;
    }

    .game-title {
      font-size: 4rem;
      margin: 0;
      color: #d63031; /* Stark atmospheric red */
      text-shadow: 0 0 15px rgba(214, 48, 49, 0.6), 2px 2px 0px #000;
      letter-spacing: 5px;
    }

    .game-subtitle-row {
      display: flex;
      justify-content: center;
      gap: 15px;
      align-items: center;
      margin-top: 5px;
    }

    .bracket-tag {
      font-size: 1.3rem;
      color: #fffa65;
      border: 1px solid #fffa65;
      padding: 1px 8px;
      letter-spacing: 2px;
      background: rgba(255, 250, 101, 0.05);
    }

    .location-tag {
      font-size: 1.4rem;
      color: #a4b0be;
      letter-spacing: 3px;
    }

    /* Terminal Console Box */
    .console-box {
      background: rgba(0, 0, 0, 0.65);
      border: 1px solid #2f3542;
      height: 160px;
      padding: 15px;
      box-sizing: border-box;
      font-size: 1.2rem;
      color: #2ed573;
      overflow-y: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
      z-index: 5;
    }

    .log-line {
      margin: 2px 0;
      line-height: 1.3;
    }

    /* Loading Bar Area */
    .loading-section {
      z-index: 5;
      text-align: center;
    }

    .progress-bar {
      font-size: 1.6rem;
      color: #f1f2f6;
      letter-spacing: 3px;
      margin-bottom: 10px;
    }

    /* Press to Start Prompt */
    #start-prompt {
      display: none;
      font-size: 2.2rem;
      color: #fffa65;
      text-shadow: 0 0 15px rgba(255, 250, 101, 0.8);
      cursor: pointer;
      animation: pulse-prompt 0.8s infinite alternate;
      letter-spacing: 2px;
    }

    @keyframes pulse-prompt {
      from { opacity: 0.3; }
      to { opacity: 1; }
    }
  </style>
</head>
<body>

  <div class="crt-container" id="screen">
    <!-- Top HUD -->
    <div class="hud-top">
      <div><span class="rec-indicator">●</span> REC [SPX-98]</div>
      <div>LOC: CHICAGO_DISTRICT_4</div>
    </div>

    <!-- Title Section (Fears to Fathom Vibe) -->
    <div class="title-block">
      <h1 class="game-title">THOSE THAT WAIT</h1>
      <div class="game-subtitle-row">
        <span class="bracket-tag">[CHICAGO]</span>
        <span class="location-tag">RADIO SHACK SHIFT #402</span>
      </div>
    </div>

    <!-- Terminal Output -->
    <div class="console-box" id="console-box">
      <div class="log-line">> BOOTING STORE_NET KERNEL V4.12...</div>
    </div>

    <!-- Loading progress & prompt -->
    <div class="loading-section">
      <div class="progress-bar" id="progress-text">[░░░░░░░░░░░░░░░░░░░░] 0%</div>
      <div id="start-prompt" onclick="enterSafeHouse()">
        [ PRESS SPACEBAR OR CLICK TO CLOCK IN ]
      </div>
    </div>
  </div>

  <script>
    const bootLogs = [
      "Mounting local drive /dev/sda1...",
      "Allocating memory buffers for inventory database...",
      "Loading audio driver: 60Hz_power_hum.raw",
      "Establishing connection to Chicago regional store server...",
      "WARNING: Integrity check failed on Storage Room C door sensor.",
      "Loading employee shift roster #402...",
      "Syncing analog video feed with back room terminal...",
      "Environment check complete. All systems stable."
    ];

    let logIdx = 0;
    let progress = 0;
    const consoleBox = document.getElementById('console-box');
    const progressText = document.getElementById('progress-text');
    const startPrompt = document.getElementById('start-prompt');

    function runLoader() {
      if (progress < 100) {
        progress += Math.floor(Math.random() * 9) + 4;
        if (progress > 100) progress = 100;

        const total = 20;
        const filled = Math.floor((progress / 100) * total);
        const bar = '█'.repeat(filled) + '░'.repeat(total - filled);
        progressText.innerText = `[${bar}] ${progress}%`;

        if (logIdx < bootLogs.length && progress > (logIdx * 12)) {
          const div = document.createElement('div');
          div.className = 'log-line';
          div.innerText = '> ' + bootLogs[logIdx];
          consoleBox.appendChild(div);
          logIdx++;
        }

        setTimeout(runLoader, Math.random() * 180 + 80);
      } else {
        progressText.innerText = "[████████████████████] 100% LOADED";
        progressText.style.color = "#2ed573";
        startPrompt.style.display = "block";
      }
    }

    setTimeout(runLoader, 600);

    function enterSafeHouse() {
      const screen = document.getElementById('screen');
      screen.style.background = "#d63031";
      setTimeout(() => {
        alert("Clocking in...\nTransitioning to the Chicago RadioShack Back Room safe house desk.");
      }, 150);
    }

    document.addEventListener('keydown', (e) => {
      if (progress >= 100 && (e.code === 'Space' || e.code === 'Enter')) {
        enterSafeHouse();
      }
    });
  </script>
</body>
</html>
